# ── Aplicação ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# Nome da imobiliária desta instalação (aparece na documentação da API)
AGENCY_NAME="Minha Imobiliária"
# Origem(ns) do front-end liberadas no CORS, separadas por vírgula. Use * em desenvolvimento.
CORS_ORIGIN=*

# ── Banco de dados ───────────────────────────────────────────────────────
# Use só letras e números na senha: ela entra na URL de conexão sem escape.
POSTGRES_USER=imob
POSTGRES_PASSWORD=TroqueEstaSenha123
POSTGRES_DB=imobiliaria
# Usada fora do Docker (npm run dev, migrações e testes). Dentro do docker compose a URL é montada sozinha.
DATABASE_URL="postgresql://imob:TroqueEstaSenha123@localhost:5432/imobiliaria"
# Fuso usado para decidir que dia é "hoje" em vencimentos e atrasos.
BUSINESS_TIMEZONE=America/Sao_Paulo

# ── Autenticação ─────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# ── Primeiro acesso ──────────────────────────────────────────────────────
# Se não existir nenhum usuário no banco, este administrador é criado na inicialização.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@imobiliaria.com.br
ADMIN_PASSWORD=TroqueEstaSenha123
